# Critter Cam detector configuration. Copy to .env and fill in real values.

# This camera's household and stable camera identity.
HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000
CAMERA_ID=front-door
CAMERA_NAME="Front door"
# USB examples: /dev/video0 or 0. Wireless examples: an RTSP or HTTP/MJPEG URL.
# Keep credentials here on the Pi; they are never published to the app/API.
CAMERA_SOURCE=/dev/video0
CAMERA_SOURCE_KIND=usb
# For a JPEG endpoint whose MJPEG stream is not FFmpeg-compatible, keep
# CAMERA_SOURCE_KIND=wireless and enable snapshot polling separately.
CAMERA_CAPTURE_MODE=usb
CAMERA_SNAPSHOT_INTERVAL=0.2
CAMERA_SNAPSHOT_TIMEOUT=5
CAMERA_ROTATION=0
HEARTBEAT_SECONDS=30
# For a PIR/deep-sleep ESP camera, keep the Pi live endpoint running while the
# source sleeps and use its local ESPHome switch to claim live-view windows.
CAMERA_MOTION_WAKE=0
# For a camera that stays powered but has its own motion sensor (the AMB82).
# With this on, the detector fetches frames only inside a motion window or
# while somebody is watching live, instead of pulling a full frame several
# times a second around the clock. Detection stays sensor-gated either way, so
# a live view can never manufacture an observation.
CAMERA_CAPTURE_ON_MOTION=0
CAPTURE_IDLE_POLL_SECONDS=0.5
CAMERA_CONTROL_URL=http://camera-hostname.local
CAMERA_CONTROL_USERNAME=cheetocam
CAMERA_CONTROL_PASSWORD=replace_with_local_device_password

# Self-hosted Cheeto Box API. This key must be the detector/service key, not a
# mobile app key: it inserts detections and camera heartbeats.
SUPABASE_URL=https://api.example.invalid
SUPABASE_ANON_KEY=replace_with_detector_service_key

# Authenticated live camera endpoint.
STREAM_PORT=8088
STREAM_TOKEN=replace_with_a_long_random_token
# Public tunnel URL for this detector instance. A second camera normally uses
# its own hostname or routed endpoint and a different local STREAM_PORT.
STREAM_PUBLIC_BASE=https://camera.example.invalid
STREAM_AUDIO_DEVICE=plughw:CARD=B100,DEV=0
# Set to 0 for a camera without its own microphone. This also keeps the app
# from offering an audio button for that camera.
STREAM_AUDIO_ENABLED=1
# A network camera carries its audio inside its own stream and has no sound
# card on the Pi. Set this to that stream's URL to read audio from it instead
# of an ALSA device; leave empty for a USB microphone.
STREAM_AUDIO_SOURCE=
# Live view output. Bytes per frame are the whole cost once a stream leaves the
# LAN, so a camera watched through the tunnel can trade sharpness for frames.
# These defaults are the values that used to be hardcoded.
STREAM_JPEG_QUALITY=70
# 0 means no cap — send frames at their native width.
STREAM_MAX_WIDTH=0

# Self-hosted notification dispatcher.
ENABLE_DISPATCH_PUSH=1
PUSH_DISPATCH_URL=http://cheeto-box:8090/push
PUSH_DISPATCH_TOKEN=replace_with_dispatch_token

# Optional transition-only Pushover delivery.
ENABLE_PUSHOVER=0
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Optional email delivery. Off by default in the database.
# The recipient lists below only seed a household that has no
# notification_settings row yet. Once that row exists the dashboard owns the
# lists — removing every recipient there really does mean nobody, and these
# values are ignored. Phone recipients are carrier gateway addresses, so they
# arrive as text messages.
SENDER_EMAIL=
SENDER_PASSWORD=
PHONE_RECIPIENTS=
EMAIL_RECIPIENTS=
BOTHER_EMAIL=

# Local detection, recognition, and activity descriptions.
ENABLE_CAT_DETECTION=1
ENABLE_SUPABASE_UPLOAD=1
ENABLE_FLORENCE=1
FLORENCE_MODEL_ID=microsoft/Florence-2-base
ENABLE_CHEETO_ID=1
CHEETO_PROTOTYPE_PATH=cheeto_prototype.npz
LEARNED_PROFILE_CACHE_PATH=learned_profiles.npz
# Each camera captures independently. Heavy CLIP/Florence work shares this many
# cross-process slots; one is safest on a four-core Pi 5.
AI_SHARED_SLOTS=1
LOCAL_AI_THREADS=2
AI_IDENTITY_WAIT_SECONDS=3
AI_CAPTION_QUEUE_SECONDS=50

DETECTION_CONFIDENCE=0.7
CONFIRM_FRAMES=2
# Species to ignore completely: no YOLO class, no capture, no caption, no
# alert. A caption naming only these also drops the detection, which catches
# the bird the nano model called a cat. Comma-separated; blank alerts on
# everything.
IGNORE_ANIMALS=bird
COOLDOWN_DURATION=180
# Save a useful frame this often while an animal remains present. Notification
# cadence is controlled separately by alert mode and cooldown settings.
OBSERVATION_INTERVAL_SECONDS=60
FRAME_DELAY=0.2
OPENWEATHER_API_KEY=
WEATHER_LAT=42.5467
WEATHER_LON=-83.2113
