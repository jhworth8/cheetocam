# Copy this file to .env and fill in the real credentials
# Example (fake) credentials

SENDER_EMAIL="youremail@gmail.com"
SENDER_PASSWORD="your_app_password"
PHONE_RECIPIENTS="1234567890@mms.att.net,0987654321@tmomail.net"
EMAIL_RECIPIENTS="recipient1@example.com,recipient2@example.com"
GEMINI_API_KEY="your_gemini_api_key"

# Toggles: 1=Enable, 0=Disable
ENABLE_GEMINI=1
# Cloud fallback to Gemini when the local Florence-2 caption is unavailable.
# OFF by default — this is a local-AI-only system. With it off, a Florence
# failure means no caption (and no caption-based false-positive filtering);
# the alert still fires with the label hedged to 'cat'.
ENABLE_GEMINI_FALLBACK=0
ENABLE_EMAIL_RESPONSE=1
ENABLE_CAT_DETECTION=1
ENABLE_EMAIL_CHECK=1
ENABLE_ALERT_SENDING=1

# Adjust these based on your preference
DETECTION_DURATION=5
COOLDOWN_DURATION=30
FRAME_DELAY=0.2
EMAIL_CHECK_INTERVAL=5

# Minimum YOLO confidence (0-1) for a box to count as a detection
DETECTION_CONFIDENCE=0.7
# Consecutive frames a detection must persist before alerting.
# 2 kills single-frame flickers (shadows, doormat patterns) at ~0.2-0.4s
# of added latency; raise to 3 if false positives persist.
CONFIRM_FRAMES=2

# Directory containing YOLO files (yolov3-tiny.weights, yolov3-tiny.cfg, coco.names)
YOLO_DIR="yolo"
